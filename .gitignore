# Secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Data (never committed - lives on the VPS / local disk only).
# Anchored to repo root so this doesn't shadow src/data/ or similarly named
# source packages.
/data/
*.parquet
*.csv
*.db
*.sqlite

# ML models (trained artifacts, not source - anchored so this doesn't
# shadow src/ml/models/, the same class of bug as the /data/ fix in Phase 2).
*.pt
*.pth
*.onnx
*.pkl
*.joblib
/reports/models/

# Reports (generated, not source)
reports/*
!reports/.gitkeep
# Exception: the Hyperliquid<->Bybit funding-carry screen's manifest is
# a small (~3KB), no-raw-data reproducibility record (parameters, data
# checksums, period, observation counts, fee schedule) - see
# scripts/screen_hyperliquid_bybit_funding_carry.py. Never add the raw
# hourly/episode data this script can also produce; only this manifest.
!reports/hyperliquid-bybit-funding-carry/
!reports/hyperliquid-bybit-funding-carry/manifest.json
# P5 sensitivity/cost-attribution follow-up - same size/content class as
# manifest.json above (no raw hourly/episode data), see
# scripts/analyze_hyperliquid_bybit_carry_sensitivity.py.
!reports/hyperliquid-bybit-funding-carry/sensitivity_manifest.json
/historical-backfill.log
/research_cycle.log

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Local ATAS custom-indicator build outputs (source remains versioned).
/integrations/atas/**/bin/
/integrations/atas/**/obj/
