# Copy this file to .env and fill in real values. Never commit .env.
# .env is already listed in .gitignore.

# --- Runtime mode -----------------------------------------------------------
# One of: RESEARCH, BACKTEST, PAPER, LIVE
# LIVE must never be enabled without an explicit, separate, later decision.
# Enforced in code (not just by convention) since Phase 10: see
# src/execution/mode.py. TRADING_MODE=LIVE is refused unless
# CONFIRM_LIVE_TRADING is ALSO set to the exact value below - do not set
# both casually, and note that a live-trading execution path doesn't exist
# yet regardless (only PAPER, against Bybit's testnet, is implemented).
TRADING_MODE=RESEARCH

# Required only to unlock TRADING_MODE=LIVE (see src/execution/mode.py).
# Leave unset for RESEARCH/BACKTEST/PAPER.
# CONFIRM_LIVE_TRADING=I_UNDERSTAND_THE_RISK

# --- Data storage -------------------------------------------------------------
# Absolute path on the host/VPS where Parquet datasets are stored.
# This directory is never committed to git.
DATA_DIR=./data

# --- Bybit API ----------------------------------------------------------------
# Not required for RESEARCH/BACKTEST (public market data only). Required for
# PAPER (scripts/paper_trade.py) - two simulation backends are supported,
# selected with --backend testnet|demo (default testnet); see
# src/execution/paper_node.py's module docstring for the full explanation
# (including why "demo" needs a real mainnet key below) and
# docs/VPS_DEPLOYMENT.md for setup.

# --backend testnet (default): requires a *separate* testnet.bybit.com
# account (geo-blocked for some EU users independent of a regular bybit.com
# account). Use Bybit TESTNET API keys here, never mainnet keys.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# --backend demo: Bybit's "Demo Trading" feature for account/order actions,
# reachable from an existing regular bybit.com login (avatar menu -> Demo
# Trading) with no separate site registration - use this if
# testnet.bybit.com registration is geo-blocked for you. Isolated,
# virtual-funds account; generate these keys while switched into Demo
# Trading mode (not your real mainnet keys).
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# --backend demo ALSO requires this: Bybit's Demo Trading REST API only
# supports private/account endpoints, so market-data (public, e.g.
# instrument lookup) must go through a plain mainnet client instead. This
# must be a REAL key from your regular bybit.com account, but a
# "Tylko do snapshotu" / read-only permission key is sufficient - it
# cannot place orders or move funds, it only authenticates public data
# reads (Bybit rejects a request with no valid key attached even for
# public endpoints).
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO

# --- docker-compose paper-session service --------------------------------------
# Required to start `docker compose up -d paper-session` - deliberately no
# default. The research worker (src/research/orchestrator.py) can only ever
# recommend a RESEARCH_CANDIDATE; promoting it to PAPER_CHALLENGER/
# PAPER_CHAMPION and pointing this service at it is a human decision made
# here, not something the worker can do on its own (src/research/promotion.py).
# PAPER_SYMBOL=BTCUSDT
# PAPER_TIMEFRAME=4h
# PAPER_STRATEGY=momentum

# --- docker-compose microstructure-collector service ----------------------------
MICROSTRUCTURE_SYMBOL=BTCUSDT
