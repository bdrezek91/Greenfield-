# Copy this file to .env and fill in real values. Never commit .env.
# .env is already listed in .gitignore.

# --- Runtime mode -----------------------------------------------------------
# One of: RESEARCH, BACKTEST, PAPER, LIVE
# LIVE must never be enabled without an explicit, separate, later decision.
# The application is expected to refuse to start in LIVE mode unless a
# dedicated safety flag (introduced in a later phase) is also set.
TRADING_MODE=RESEARCH

# --- Data storage -------------------------------------------------------------
# Absolute path on the host/VPS where Parquet datasets are stored.
# This directory is never committed to git.
DATA_DIR=./data

# --- Bybit API (not required until the data/execution layers exist) --------
# Read-only market data keys are enough for research/backtest; trading keys
# are only needed once PAPER/LIVE execution is implemented.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
