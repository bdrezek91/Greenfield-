# Copy this file to .env and fill in real values. Never commit .env.
# .env is already listed in .gitignore.

# --- Runtime mode -----------------------------------------------------------
# One of: RESEARCH, BACKTEST, SHADOW, PAPER, LIVE
# LIVE must never be enabled without an explicit, separate, later decision.
# Enforced in code (not just by convention) since Phase 10: see
# src/execution/mode.py. TRADING_MODE=LIVE is refused unless
# CONFIRM_LIVE_TRADING is ALSO set to the exact value below - do not set
# both casually, and note that a live-trading execution path doesn't exist
# yet regardless (only PAPER, against isolated Bybit simulation environments,
# is implemented).
TRADING_MODE=RESEARCH

# Required only to unlock TRADING_MODE=LIVE (see src/execution/mode.py).
# Leave unset for RESEARCH/BACKTEST/SHADOW/PAPER.
# CONFIRM_LIVE_TRADING=I_UNDERSTAND_THE_RISK

# --- Data storage -------------------------------------------------------------
# Isolate every Compose object created by this v2 checkout from older projects.
COMPOSE_PROJECT_NAME=greenfield-v2

# Absolute path on the host/VPS where Parquet datasets are stored.
# This directory is never committed to git.
DATA_DIR=./data

# --- Bybit API ----------------------------------------------------------------
# Not required for RESEARCH/BACKTEST (public market data only). Required for
# PAPER (scripts/paper_trade.py) - two simulation backends are supported,
# selected with --backend testnet|demo (default testnet); see
# src/execution/paper_node.py's module docstring for the full explanation
# (including why "demo" needs a real mainnet key below) and
# docs/VPS_DEPLOYMENT.md for setup.

# --backend testnet (default): requires a *separate* testnet.bybit.com
# account (geo-blocked for some EU users independent of a regular bybit.com
# account). Use Bybit TESTNET API keys here, never mainnet keys.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# --backend demo: Bybit's "Demo Trading" feature for account/order actions,
# reachable from an existing regular bybit.com login (avatar menu -> Demo
# Trading) with no separate site registration - use this if
# testnet.bybit.com registration is geo-blocked for you. Isolated,
# virtual-funds account; generate these keys while switched into Demo
# Trading mode (not your real mainnet keys).
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# Greenfield v2's strict Demo gateway uses ONLY the two Demo variables above,
# is pinned in code to https://api-demo.bybit.com, and rejects mainnet keys.
# Keep its real values in a separate gitignored `bybit-demo.env` (mode 600),
# together with TRADING_MODE=PAPER. Add the confirmation below only for a
# single, operator-requested place/cancel smoke test; read-only preflight does
# not need it.
# GREENFIELD_DEMO_ORDER_CONFIRMATION=BYBIT_DEMO_ONLY
# A BTC 100 USDT-notional / 100x Demo round-trip additionally requires this
# narrower one-operation confirmation. Remove both confirmations afterwards.
# GREENFIELD_DEMO_BTC_ROUND_TRIP_CONFIRMATION=BTC_100_USDT_100X_DEMO_ONLY

# LEGACY Nautilus `scripts/paper_trade.py --backend demo` ALSO requires this;
# the new strict v2 preflight/smoke path deliberately does not. Bybit's Demo
# Trading REST API only supports private/account endpoints, so market-data (public, e.g.
# instrument lookup) must go through a plain mainnet client instead. This
# must be a REAL key from your regular bybit.com account, but a
# "Tylko do snapshotu" / read-only permission key is sufficient - it
# cannot place orders or move funds, it only authenticates public data
# reads (Bybit rejects a request with no valid key attached even for
# public endpoints).
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO

# --- docker-compose paper-session service --------------------------------------
# Required to start `docker compose up -d paper-session` - deliberately no
# default. The research worker (src/research/orchestrator.py) can only ever
# recommend a RESEARCH_CANDIDATE; promoting it to PAPER_CHALLENGER/
# PAPER_CHAMPION and pointing this service at it is a human decision made
# here, not something the worker can do on its own (src/research/promotion.py).
# PAPER_SYMBOL=BTCUSDT
# PAPER_TIMEFRAME=4h
# PAPER_STRATEGY=momentum

# --- docker-compose shadow-service ----------------------------------------------
# Required to start `docker compose --profile shadow up -d shadow-service` -
# deliberately no default (see src/execution/shadow_service.py). This
# process imports no execution adapter and can never submit a real order;
# it only observes Meta Decisions from the durable queue and maintains
# virtual portfolio/audit state. Disabled by default and isolated from the
# active Phase 1 Bybit soak.
# SHADOW_SESSION_ID=shadow-20260823
# SHADOW_DATASET_FINGERPRINT=
# SHADOW_CONFIG_FINGERPRINT=

# --- Greenfield v2 raw collectors ----------------------------------------------
# BTC/ETH/SOL raw collectors use public WebSockets and need no API credentials.
# COLLECTOR_ID is supplied by docker-compose for isolated health files.

# --- Phase 1 monitoring -------------------------------------------------------
# Required only when using docker-compose.monitoring.yml. Generate a unique,
# high-entropy password; the Grafana port remains bound to localhost by default
# and should be reached through an SSH tunnel.
# GRAFANA_ADMIN_PASSWORD=

# Optional generic HTTPS endpoint that accepts Alertmanager-compatible JSON.
# Every alert is durably journaled locally before forwarding. Do not point this
# directly at a vendor webhook that expects a different payload schema; use an
# HTTPS automation/adapter endpoint in that case. The bearer token is optional.
# ALERT_FORWARD_URL=https://alerts.example.net/greenfield
# ALERT_FORWARD_BEARER_TOKEN=

# Keep the default loopback bind on a VPS. Set another address only after adding
# an authenticated reverse proxy and firewall rules.
# MONITORING_BIND_ADDRESS=127.0.0.1

# --- Legacy reduced microstructure collector -----------------------------------
MICROSTRUCTURE_SYMBOL=BTCUSDT

# Continuous experimental trading is accepted only by the Demo-only scalper.
# It does not promote an edge and is ignored by every LIVE path.
# GREENFIELD_DEMO_SCALP_CONFIRMATION=CONTINUOUS_BYBIT_DEMO_SCALP_ONLY
# DEMO_SCALP_FORCE_ONCE=LONG
# DEMO_SCALP_STOP_LOSS_BPS=50
